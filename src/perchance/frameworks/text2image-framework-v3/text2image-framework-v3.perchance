// https://perchance.org/text2image-framework-v3
// text2image-framework
// Standalone framework with advanced modules:
// - share-link export/import
// - modifier groups
// - persona/chat hooks
// - visual style selection

textToImagePlugin = {import:text-to-image-plugin}
commentsPlugin = {import:comments-plugin}
createMediaGalleryPlugin = {import:create-media-gallery-plugin}
selectLeaf = {import:select-leaf-plugin}
fullscreenButton = {import:fullscreen-button-plugin}
upload = {import:upload-plugin}
aiText = {import:ai-text-plugin}

$output(settings) =>
	if(!settings) settings = {};

	if(!settings.pageTitle) settings.pageTitle = "TextToImage Framework";
	if(!settings.subtitle) settings.subtitle = "Advanced generation workspace with share links, robust grouped modifiers, search, sort, favorites, and persona/chat tools.";
	if(!settings.theme) settings.theme = "aurora";
	if(settings.showComments === undefined) settings.showComments = false;
	if(settings.enableShareLinks === undefined) settings.enableShareLinks = true;
	if(settings.enableModifierGroups === undefined) settings.enableModifierGroups = true;
	if(settings.enablePersonaHooks === undefined) settings.enablePersonaHooks = true;
	if(settings.enableRandomInputButton === undefined) settings.enableRandomInputButton = true;
	if(settings.enableAiSuggestButton === undefined) settings.enableAiSuggestButton = true;
	if(settings.enableRandomAppendButton === undefined) settings.enableRandomAppendButton = true;
	if(!settings.commentOptions) settings.commentOptions = {channel:"t2i-framework", hideFullscreenButton:true};
	if(!settings.imageOptions) settings.imageOptions = {};
	if(!settings.imageButtons) settings.imageButtons = {};
	if(settings.imageButtons.privateSave === undefined) settings.imageButtons.privateSave = true;
	if(!settings.defaultPrompt) settings.defaultPrompt = "cinematic portrait, dramatic lighting, highly detailed";
	if(!settings.defaultNegativePrompt) settings.defaultNegativePrompt = "blurry, low quality, watermark, text";
	if(!settings.defaultSeed) settings.defaultSeed = "";
	if(!settings.defaultImageCount) settings.defaultImageCount = 6;
	if(!settings.aiSuggestMode) settings.aiSuggestMode = "append";
	if(!settings.aiSuggestInstruction) settings.aiSuggestInstruction = "Generate one concise image-prompt continuation based on the user's current prompt and selected style. Return only the prompt text and no explanations.";
	if(settings.aiSuggestMaxCharacters === undefined) settings.aiSuggestMaxCharacters = 220;
	if(!settings.randomPromptPool) settings.randomPromptPool = ["cinematic portrait, dramatic rim light, high detail", "fantasy hero in a ruined temple, volumetric light", "stylized anime character, vibrant color palette", "pixel art creature design, clean silhouette"];
	if(!settings.randomAppendPool) settings.randomAppendPool = ["highly detailed", "dynamic composition", "sharp focus", "rich color grading", "volumetric lighting"];
	if(settings.enableStyleSearch === undefined) settings.enableStyleSearch = true;
	if(settings.enableStyleSort === undefined) settings.enableStyleSort = true;
	if(settings.enableStyleFavorites === undefined) settings.enableStyleFavorites = true;
	if(settings.enableFavoritesOnlyToggle === undefined) settings.enableFavoritesOnlyToggle = true;
	if(settings.enableStyleCounts === undefined) settings.enableStyleCounts = true;
	if(settings.enableRecentStyles === undefined) settings.enableRecentStyles = true;
	if(settings.randomStyleRespectsFilters === undefined) settings.randomStyleRespectsFilters = false;
	if(!settings.styleSearchPlaceholder) settings.styleSearchPlaceholder = "Search styles by name, group, or tags";
	if(!settings.defaultStyleSort) settings.defaultStyleSort = "featured";
	if(!settings.favoriteStorageKey) settings.favoriteStorageKey = "t2i-framework-v3:favorites";
	if(!settings.styleSortOptions) {
		settings.styleSortOptions = [
			{value:"featured", label:"Featured"},
			{value:"favorites", label:"Favorites First"},
			{value:"recent", label:"Recent"},
			{value:"alphabetical", label:"A-Z"},
			{value:"group", label:"Group"},
			{value:"random", label:"Random"},
		];
	}
	if(!settings.styleOptions) {
		settings.styleOptions = [
			{name:"none", label:"None"},
			{name:"cinematic", label:"Cinematic", promptSuffix:"cinematic color grading, 35mm film look", swatch:"linear-gradient(135deg, #5fa8ff, #ffd166)"},
			{name:"anime", label:"Anime", promptSuffix:"anime style, cel shading, expressive line art", negativeSuffix:"photorealistic", swatch:"linear-gradient(135deg, #ff7aa2, #8ec5ff)"},
			{name:"photoreal", label:"Photoreal", promptSuffix:"photorealistic, realistic skin texture, ultra detailed", swatch:"linear-gradient(135deg, #8de1b5, #7fa0ff)"},
			{name:"fantasy", label:"Fantasy", promptSuffix:"epic fantasy concept art, atmospheric lighting", swatch:"linear-gradient(135deg, #a78bfa, #f59e0b)"},
		];
	}
	if(!settings.modifierGroups) {
		settings.modifierGroups = [
			{
				id: "camera",
				label: "Camera",
				mode: "append",
				options: [
					{name:"None", prompt:"", negative:""},
					{name:"Wide Angle", prompt:"wide angle lens, dramatic perspective", negative:""},
					{name:"Portrait Lens", prompt:"85mm portrait lens, shallow depth of field", negative:""},
					{name:"Macro", prompt:"macro photography, extreme detail", negative:""},
				],
			},
			{
				id: "lighting",
				label: "Lighting",
				mode: "append",
				options: [
					{name:"None", prompt:"", negative:""},
					{name:"Golden Hour", prompt:"golden hour lighting, warm highlights", negative:""},
					{name:"Neon", prompt:"neon rim lighting, urban glow", negative:"flat lighting"},
					{name:"Studio", prompt:"studio softbox setup, crisp shadows", negative:""},
				],
			},
      {
				id: "mood",
				label: "Mood",
				mode: "append",
				options: [
					{name:"None", prompt:"", negative:""},
					{name:"Mysterious", prompt:"mysterious atmosphere, soft shadows", negative:""},
					{name:"Energetic", prompt:"dynamic energy, vibrant colors", negative:""},
					{name:"Serene", prompt:"calm and peaceful, soft lighting", negative:""},
				],
			},
		];
	}
	if(!settings.persona) settings.persona = {};
	if(settings.persona.enableAiDescription === undefined) settings.persona.enableAiDescription = false;
	if(!settings.persona.defaultInstruction) settings.persona.defaultInstruction = "Create a concise, vivid persona with name, personality, and backstory inspired by the image prompt.";
	if(!settings.persona.chatBaseUrl) settings.persona.chatBaseUrl = "https://perchance.org/ai-character-chat";

	if(!window.input) window.input = {};
	if(window.input.description === undefined) window.input.description = String(settings.defaultPrompt || "");
	if(window.input.negative === undefined) window.input.negative = String(settings.defaultNegativePrompt || "");

	let themeMap = {
		aurora: {bgA:"#0d1b2a", bgB:"#1b263b", bgC:"#274060", panel:"rgba(16,26,40,0.78)", text:"#e7eef6", muted:"#9bb0ca", line:"rgba(170,196,228,0.3)", accent:"#59d4ff", accent2:"#ffd166", hover:"rgba(89,212,255,0.2)", fixedpanel:"rgba(16,26,54)"},
		sunrise: {bgA:"#2d1b2e", bgB:"#6d2e46", bgC:"#b56576", panel:"rgba(54,27,42,0.78)", text:"#fff3eb", muted:"#f2d3c0", line:"rgba(255,218,191,0.35)", accent:"#9df7e5", accent2:"#ffd6a5", hover:"rgba(157,247,229,0.2)", fixedpanel:"rgba(54,27,42)"},
		slate: {bgA:"#14171f", bgB:"#202534", bgC:"#2d3143", panel:"rgba(22,27,38,0.78)", text:"#f1f4fa", muted:"#b6becc", line:"rgba(160,174,199,0.3)", accent:"#80ed99", accent2:"#ffd166", hover:"rgba(128,237,153,0.2)", fixedpanel:"rgba(22,54,38)"},
	};
	let theme = themeMap[settings.theme] || themeMap.aurora;

	if(!window.__t2iFrameworkState48739) {
		window.__t2iFrameworkState48739 = {
			version: "6.0.0",
			buildDate: "2026-04-22",
			privateGallery: null,
			favoriteStyles: new Set(),
			recentStyles: [],
			lastStyleSearch: "",
			lastStyleSort: String(settings.defaultStyleSort || "featured"),
			showFavoritesOnly: false,
		};
	}
	if(!(window.__t2iFrameworkState48739.favoriteStyles instanceof Set)) window.__t2iFrameworkState48739.favoriteStyles = new Set();
	if(!Array.isArray(window.__t2iFrameworkState48739.recentStyles)) window.__t2iFrameworkState48739.recentStyles = [];
	if(window.__t2iFrameworkState48739.lastStyleSearch === undefined) window.__t2iFrameworkState48739.lastStyleSearch = "";
	if(window.__t2iFrameworkState48739.lastStyleSort === undefined) window.__t2iFrameworkState48739.lastStyleSort = String(settings.defaultStyleSort || "featured");
	if(window.__t2iFrameworkState48739.showFavoritesOnly === undefined) window.__t2iFrameworkState48739.showFavoritesOnly = false;

	if(settings.imageButtons.privateSave && !window.__t2iFrameworkState48739.privateGallery) {
		window.__t2iFrameworkState48739.privateGallery = createMediaGalleryPlugin();
	}

	window.__t2iFrameworkSettings48739 = settings;
	window.__t2iFrameworkTextPlugin48739 = textToImagePlugin;
	window.__t2iFrameworkCommentsPlugin48739 = commentsPlugin;

	window.__t2iGetStyleCatalog48739 = function() {
		return window.__t2iResolvedStyles48739 || [];
	};

	window.__t2iGetStyleNodeByKey48739 = function(styleKey) {
		let styleMap = window.__t2iArtStyleMap48739 || {};
		return styleMap[styleKey] || null;
	};

	window.__t2iEvaluateStyleField48739 = function(field) {
		if(field === undefined || field === null) return "";
		if(field.evaluateItem !== undefined) return String(field.evaluateItem);
		return String(field);
	};

	window.__t2iEvaluateBoolean48739 = function(value) {
		if(value === true) return true;
		if(value === false || value === undefined || value === null) return false;
		if(value.evaluateItem !== undefined) {
			let evaluated = String(value.evaluateItem || "").trim().toLowerCase();
			return evaluated === "true" || evaluated === "1" || evaluated === "yes";
		}
		let text = String(value || "").trim().toLowerCase();
		return text === "true" || text === "1" || text === "yes";
	};

	window.__t2iEscapeAttr48739 = function(value) {
		return String(value === undefined || value === null ? "" : value)
			.replaceAll("&", "&amp;")
			.replaceAll("\"", "&quot;")
			.replaceAll("<", "&lt;");
	};

	window.__t2iGetNodeKeys48739 = function(node) {
		if(!node) return [];
		let keys = node.getAllKeys || node.getChildNames || [];
		if(Array.isArray(keys)) return keys;
		try {
			return [...keys];
		} catch(e) {
			return [];
		}
	};

	window.__t2iGetStyleByName48739 = function(styleName) {
		let catalog = window.__t2iGetStyleCatalog48739();
		for(let style of catalog) {
			if(style.name === styleName) return style;
		}
		return {name:"none", label:"None"};
	};

	window.__t2iGetFavoriteStorageKey48739 = function() {
		return String(window.__t2iFrameworkSettings48739.favoriteStorageKey || "t2i-framework-v3:favorites");
	};

	window.__t2iLoadFavoriteStyles48739 = function() {
		if(!window.__t2iFrameworkSettings48739.enableStyleFavorites) return new Set();
		try {
			let raw = localStorage.getItem(window.__t2iGetFavoriteStorageKey48739());
			if(!raw) return new Set();
			let parsed = JSON.parse(raw);
			if(Array.isArray(parsed)) return new Set(parsed.map(v => String(v)));
			return new Set();
		} catch(e) {
			console.error(e);
			return new Set();
		}
	};

	window.__t2iSaveFavoriteStyles48739 = function() {
		if(!window.__t2iFrameworkSettings48739.enableStyleFavorites) return;
		try {
			let state = window.__t2iFrameworkState48739 || {};
			let values = [...(state.favoriteStyles || new Set())];
			localStorage.setItem(window.__t2iGetFavoriteStorageKey48739(), JSON.stringify(values));
		} catch(e) {
			console.error(e);
		}
	};

	window.__t2iIsStyleFavorite48739 = function(styleName) {
		let state = window.__t2iFrameworkState48739 || {};
		if(!(state.favoriteStyles instanceof Set)) state.favoriteStyles = new Set();
		return state.favoriteStyles.has(String(styleName || ""));
	};

	window.__t2iToggleFavoriteStyle48739 = function(styleName) {
		if(!window.__t2iFrameworkSettings48739.enableStyleFavorites) return;
		let key = String(styleName || "");
		if(!key) return;
		let state = window.__t2iFrameworkState48739 || {};
		if(!(state.favoriteStyles instanceof Set)) state.favoriteStyles = new Set();
		if(state.favoriteStyles.has(key)) {
			state.favoriteStyles.delete(key);
		} else {
			state.favoriteStyles.add(key);
		}
		window.__t2iSaveFavoriteStyles48739();
		window.__t2iRefreshStyleCards48739();
	};

	window.__t2iMarkStyleUsed48739 = function(styleName) {
		if(!window.__t2iFrameworkSettings48739.enableRecentStyles) return;
		let key = String(styleName || "");
		if(!key) return;
		let state = window.__t2iFrameworkState48739 || {};
		if(!Array.isArray(state.recentStyles)) state.recentStyles = [];
		state.recentStyles = state.recentStyles.filter(v => v !== key);
		state.recentStyles.unshift(key);
		if(state.recentStyles.length > 40) state.recentStyles = state.recentStyles.slice(0, 40);
	};

	window.__t2iNormalizeSearchText48739 = function(text) {
		return String(text || "").trim().toLowerCase().replace(/\s+/g, " ");
	};

	window.__t2iGetSelectedStyleNode48739 = function() {
		let styleKey = document.querySelector("#t2iStyleEl48739")?.value || "";
		return window.__t2iGetStyleNodeByKey48739(styleKey);
	};

	window.__t2iSyncInputVars48739 = function() {
		if(!window.input) window.input = {};
		let promptVal = document.querySelector("#t2iPromptEl48739")?.value;
		let negVal = document.querySelector("#t2iNegativeEl48739")?.value;
		if(promptVal !== undefined) {
			window.input.description = String(promptVal);
		} else if(window.input.description === undefined) {
			window.input.description = String(settings.defaultPrompt || "");
		}
		if(negVal !== undefined) {
			window.input.negative = String(negVal);
		} else if(window.input.negative === undefined) {
			window.input.negative = String(settings.defaultNegativePrompt || "");
		}
	};

	window.__t2iGetStyleModifierGroups48739 = function(styleNode) {
		if(!styleNode || !styleNode.modifiers) return [];
		let modifiersRoot = styleNode.modifiers;

		function isHelperKey(keyText) {
			return keyText === "color" || keyText === "label" || keyText === "tagWeights" || keyText === "name";
		}

		function isIgnoredKey(keyText) {
			if(keyText.startsWith("meta:")) return true;
			return isHelperKey(keyText);
		}

		function getEntries(node) {
			if(!node) return [];
			let keys = window.__t2iGetNodeKeys48739(node);
			let entries = [];
			for(let key of keys) {
				let keyText = String(key);
				if(keyText.startsWith("meta:import")) {
					let importNode = node[key];
					let sourceNode = importNode?.from || importNode;
					if(sourceNode) entries.push({key:keyText, value:sourceNode, isImport:true});
					continue;
				}
				if(isIgnoredKey(keyText)) continue;
				let value = node[key];
				if(value === undefined || value === null) continue;
				entries.push({key:keyText, value, isImport:false});
			}
			return entries;
		}

		function isLeafOptionValue(value) {
			if(value === undefined || value === null) return false;
			if(value.prompt !== undefined || value.negative !== undefined || value.mode !== undefined || value.name !== undefined) return true;
			let nestedEntries = getEntries(value);
			return nestedEntries.length === 0;
		}

		function normalizeOption(keyText, value) {
			if(value === undefined || value === null) return null;
			let isRichOption = value.prompt !== undefined || value.negative !== undefined || value.mode !== undefined || value.name !== undefined;
			let name = String(window.__t2iEvaluateStyleField48739(isRichOption ? (value.name || keyText) : keyText) || keyText || "Option");
			let prompt = String(window.__t2iEvaluateStyleField48739(isRichOption ? (value.prompt || "") : value || ""));
			let negative = String(window.__t2iEvaluateStyleField48739(isRichOption ? (value.negative || "") : ""));
			let modeText = String(window.__t2iEvaluateStyleField48739(isRichOption ? (value.mode || "append") : "append")).trim().toLowerCase();
			return {
				name,
				prompt,
				negative,
				mode: modeText === "prepend" ? "prepend" : "append",
				selected: window.__t2iEvaluateBoolean48739(value["meta:selected"]),
				disabled: window.__t2iEvaluateBoolean48739(value["meta:disabled"]),
			};
		}

		function collectLeafOptions(node, out = [], seen = new Set()) {
			if(!node || seen.has(node)) return out;
			seen.add(node);
			let entries = getEntries(node);
			if(entries.length === 0) return out;

			for(let entry of entries) {
				if(isLeafOptionValue(entry.value)) {
					let option = normalizeOption(entry.key, entry.value);
					if(option) out.push(option);
				} else {
					collectLeafOptions(entry.value, out, seen);
				}
			}

			return out;
		}

		function buildGroupId(pathParts) {
			let raw = pathParts.filter(Boolean).join("_").replace(/[^a-zA-Z0-9_-]/g, "_");
			return raw || "modifier_group";
		}

		function resolveGroupLabel(pathParts, node) {
			let fallback = String(pathParts[pathParts.length - 1] || "modifier");
			let resolved = String(window.__t2iEvaluateStyleField48739(node?.label || node?.name || fallback) || fallback);
			if(resolved && !/^\d+$/.test(resolved)) return resolved;
			if(pathParts.length > 1) {
				let parent = String(pathParts[pathParts.length - 2] || "Group");
				let child = String(pathParts[pathParts.length - 1] || "Modifier");
				let readableParent = /^\d+$/.test(parent) ? `Group ${Number(parent) + 1}` : parent;
				let readableChild = /^\d+$/.test(child) ? `Option ${Number(child) + 1}` : child;
				return `${readableParent}: ${readableChild}`;
			}
			return resolved || "Modifier";
		}

		let groups = [];

		function addGroup(node, pathParts) {
			let options = collectLeafOptions(node, []).filter(o => !o.disabled);
			if(options.length === 0) return;
			let hasSelected = options.some(o => o.selected);
			options.unshift({
				name: "None",
				prompt: "",
				negative: "",
				mode: "append",
				selected: !hasSelected,
				disabled: false,
			});
			groups.push({
				id: buildGroupId(pathParts),
				label: resolveGroupLabel(pathParts, node),
				options,
			});
		}

		function traverse(node, pathParts = [], seen = new Set()) {
			if(!node || seen.has(node)) return;
			seen.add(node);

			let entries = getEntries(node);
			if(entries.length === 0) return;

			let directLeafCount = 0;
			let containerCount = 0;
			for(let entry of entries) {
				if(isLeafOptionValue(entry.value)) {
					directLeafCount++;
				} else {
					containerCount++;
				}
			}

			let shouldBeGroup = directLeafCount > 0;
			if(shouldBeGroup) {
				addGroup(node, pathParts.length > 0 ? pathParts : ["modifiers"]);
			}

			for(let entry of entries) {
				if(!isLeafOptionValue(entry.value)) {
					let nextPart = entry.isImport ? (pathParts[pathParts.length - 1] || "import") : entry.key;
					let nextPath = pathParts.length > 0 ? pathParts.concat([nextPart]) : [nextPart];
					traverse(entry.value, nextPath, seen);
				}
			}
		}

		traverse(modifiersRoot, []);

		if(groups.length === 0) {
			addGroup(modifiersRoot, ["modifiers"]);
		}

		let seenIds = new Set();
		for(let i = 0; i < groups.length; i++) {
			let baseId = groups[i].id || `modifier_group_${i + 1}`;
			let id = baseId;
			let suffix = 2;
			while(seenIds.has(id)) {
				id = `${baseId}_${suffix++}`;
			}
			seenIds.add(id);
			groups[i].id = id;
		}

		return groups;
	};

	window.__t2iRenderStyleModifierInputs48739 = function() {
		let rowEl = document.querySelector("#t2iStyleModifiersRow48739");
		if(!rowEl) return;
		let styleNode = window.__t2iGetSelectedStyleNode48739();
		let groups = window.__t2iGetStyleModifierGroups48739(styleNode);
		if(groups.length === 0) {
			rowEl.innerHTML = "";
			rowEl.style.display = "none";
			return;
		}
		rowEl.style.display = "grid";
		rowEl.innerHTML = groups.map(g => {
			let opts = g.options.map(o => {
				let prompt = window.__t2iEscapeAttr48739(o.prompt || "");
				let negative = window.__t2iEscapeAttr48739(o.negative || "");
				let mode = window.__t2iEscapeAttr48739(o.mode || "append");
				let name = window.__t2iEscapeAttr48739(o.name || "Option");
				return `<option value="${prompt}" data-negative="${negative}" data-mode="${mode}" ${o.selected ? "selected" : ""}>${name}</option>`;
			}).join("\n");
			return `<div class="t2iField48739 t2iSpan3"><label>${g.label}</label><select id="t2iStyleMod_${g.id}_48739">${opts}</select></div>`;
		}).join("\n");
	};

	window.__t2iPickRandomItem48739 = function(pool) {
		if(pool === undefined || pool === null) return "";
		try {
			if(pool.getChildNames || pool.selectAll || pool.evaluateItem !== undefined) {
				return String(selectLeaf(pool).evaluateItem || "").trim();
			}
		} catch(e) {
			console.error(e);
		}
		if(Array.isArray(pool)) {
			if(pool.length === 0) return "";
			return String(pool[Math.floor(Math.random() * pool.length)] || "").trim();
		}
		return String(pool || "").trim();
	};

	window.__t2iRandomInput48739 = function() {
		let promptEl = document.querySelector("#t2iPromptEl48739");
		if(!promptEl) return;
		let styleNode = window.__t2iGetSelectedStyleNode48739();
		let pool = styleNode?.randomPrompt || styleNode?.random || settings.randomPromptPool;
		let picked = window.__t2iPickRandomItem48739(pool);
		if(!picked) return;
		promptEl.value = picked;
		promptEl.dispatchEvent(new Event("input", {bubbles:true}));
	};

	window.__t2iRandomAppend48739 = function() {
		let promptEl = document.querySelector("#t2iPromptEl48739");
		if(!promptEl) return;
		let styleNode = window.__t2iGetSelectedStyleNode48739();
		let pool = styleNode?.randomAppend || settings.randomAppendPool;
		let picked = window.__t2iPickRandomItem48739(pool);
		if(!picked) return;
		let cur = (promptEl.value || "").trim();
		if(!cur) {
			promptEl.value = picked;
		} else {
			promptEl.value = `${cur}${picked.startsWith(",") ? "" : ", "}${picked}`;
		}
		promptEl.dispatchEvent(new Event("input", {bubbles:true}));
	};

	window.__t2iAiSuggest48739 = async function(btn) {
		let promptEl = document.querySelector("#t2iPromptEl48739");
		let styleEl = document.querySelector("#t2iStyleEl48739");
		let negEl = document.querySelector("#t2iNegativeEl48739");
		if(!promptEl) return;
		let oldBtnText = btn ? btn.textContent : "AI Suggest";
		if(btn) {
			btn.disabled = true;
			btn.textContent = "Thinking...";
		}
		try {
			let styleLabel = styleEl?.selectedOptions?.[0]?.textContent || styleEl?.value || "none";
			let currentPrompt = (promptEl.value || "").trim();
			let currentNegative = (negEl?.value || "").trim();
			let fullInstruction = `${settings.aiSuggestInstruction}\n\nPrompt: ${currentPrompt}\nNegative: ${currentNegative}\nStyle: ${styleLabel}`;
			let out = await aiText({instruction: fullInstruction, maxCharacters: Number(settings.aiSuggestMaxCharacters || 220)});
			let suggestion = String(out?.text || out || "").trim();
			if(!suggestion) return;
			if(settings.aiSuggestMode === "replace" || !currentPrompt) {
				promptEl.value = suggestion;
			} else {
				promptEl.value = `${currentPrompt}, ${suggestion}`;
			}
			promptEl.dispatchEvent(new Event("input", {bubbles:true}));
		} catch(e) {
			console.error(e);
			alert("AI suggestion failed.");
		} finally {
			if(btn) {
				btn.disabled = false;
				btn.textContent = oldBtnText;
			}
		}
	};

	window.__t2iApplyStylePrompt48739 = function(basePrompt, styleName) {
		window.__t2iSyncInputVars48739();
		let styleNode = window.__t2iGetStyleNodeByKey48739(styleName);
		if(styleNode && styleNode.prompt !== undefined) {
			if(!window.input) window.input = {};
			window.input.description = String(basePrompt || "");
			if(window.input.negative === undefined) window.input.negative = String(settings.defaultNegativePrompt || "");
			let evaluatedPrompt = window.__t2iEvaluateStyleField48739(styleNode.prompt);
			return evaluatedPrompt || basePrompt;
		}
		if(!styleName || styleName === "none") return basePrompt;
		let style = window.__t2iGetStyleByName48739(styleName);
		return [style.promptPrefix, basePrompt, style.promptSuffix].filter(Boolean).join(", ");
	};

	window.__t2iApplyStyleNegative48739 = function(baseNegative, styleName) {
		window.__t2iSyncInputVars48739();
		let styleNode = window.__t2iGetStyleNodeByKey48739(styleName);
		if(styleNode && styleNode.negative !== undefined) {
			if(!window.input) window.input = {};
			window.input.negative = String(baseNegative || "");
			if(window.input.description === undefined) window.input.description = String(settings.defaultPrompt || "");
			let evaluatedNegative = window.__t2iEvaluateStyleField48739(styleNode.negative);
			return evaluatedNegative || baseNegative;
		}
		if(!styleName || styleName === "none") return baseNegative;
		let style = window.__t2iGetStyleByName48739(styleName);
		return [baseNegative, style.negativeSuffix].filter(Boolean).join(", ");
	};

	window.__t2iRandomStyle48739 = function() {
		let selectEl = document.querySelector("#t2iStyleEl48739");
		if(!selectEl) return;
		let filteredStyles = window.__t2iGetFilteredSortedStyles48739().styles.filter(style => !style.disabled);
		let enabledStyles = window.__t2iFrameworkSettings48739.randomStyleRespectsFilters
			? filteredStyles
			: window.__t2iGetStyleCatalog48739().filter(style => !style.disabled);
		if(enabledStyles.length === 0) return;

		let randomKey = "";
		if(window.__t2iArtStyleOptionsRoot48739) {
			try {
				for(let i = 0; i < 24; i++) {
					let picked = selectLeaf(window.__t2iArtStyleOptionsRoot48739);
					let pickedName = String((picked && picked.getName) || "");
					let candidate = (window.__t2iArtStyleKeyByName48739 || {})[pickedName] || "";
					if(candidate && enabledStyles.some(style => style.name === candidate)) {
						randomKey = candidate;
						break;
					}
				}
			} catch(e) {
				console.error(e);
			}
		}

		if(!randomKey) {
			let idx = Math.floor(Math.random() * enabledStyles.length);
			randomKey = enabledStyles[idx].name;
		}

		if(randomKey) {
			selectEl.value = randomKey;
			window.__t2iMarkStyleUsed48739(randomKey);
			window.__t2iRefreshStyleCards48739();
		}
	};

	window.__t2iCollectModifierEffects48739 = function() {
		let groups = window.__t2iFrameworkSettings48739.modifierGroups || [];
		let promptPrefix = [];
		let promptSuffix = [];
		let negativeSuffix = [];
		let selected = {};

		for(let group of groups) {
			let id = group.id || group.label || "group";
			let el = document.querySelector(`#t2iMod_${id}_48739`);
			let selectedName = el?.value || "";
			selected[id] = selectedName;
			let option = (group.options || []).find(o => o.name === selectedName) || (group.options || [])[0] || {};
			let mode = group.mode || "append";
			if(option.prompt) {
				if(mode === "prepend") {
					promptPrefix.push(option.prompt);
				} else {
					promptSuffix.push(option.prompt);
				}
			}
			if(option.negative) negativeSuffix.push(option.negative);
		}

		let styleNode = window.__t2iGetSelectedStyleNode48739();
		let styleModifierGroups = window.__t2iGetStyleModifierGroups48739(styleNode);
		for(let group of styleModifierGroups) {
			let el = document.querySelector(`#t2iStyleMod_${group.id}_48739`);
			let selectedOption = el?.selectedOptions?.[0] || null;
			let promptVal = String(selectedOption?.value || "").trim();
			let negativeVal = String(selectedOption?.dataset?.negative || "").trim();
			let mode = String(selectedOption?.dataset?.mode || "append").trim().toLowerCase();
			if(promptVal) {
				if(mode === "prepend") {
					promptPrefix.push(promptVal);
				} else {
					promptSuffix.push(promptVal);
				}
			}
			if(negativeVal) negativeSuffix.push(negativeVal);
			selected[`style:${group.id}`] = promptVal;
		}

		return {
			promptPrefix: promptPrefix.filter(Boolean).join(", "),
			promptSuffix: promptSuffix.filter(Boolean).join(", "),
			negativeSuffix: negativeSuffix.filter(Boolean).join(", "),
			selected,
		};
	};

	window.__t2iBuildImageOptions48739 = function() {
		let promptEl = document.querySelector("#t2iPromptEl48739");
		let negativeEl = document.querySelector("#t2iNegativeEl48739");
		let seedEl = document.querySelector("#t2iSeedEl48739");
		let styleEl = document.querySelector("#t2iStyleEl48739");
		let widthEl = document.querySelector("#t2iWidthEl48739");
		let heightEl = document.querySelector("#t2iHeightEl48739");
		let guidanceEl = document.querySelector("#t2iGuidanceEl48739");
		let stepsEl = document.querySelector("#t2iStepsEl48739");

		let prompt = (promptEl?.value || "").trim();
		let negativePrompt = (negativeEl?.value || "").trim();
		let style = styleEl?.value || "none";
		let seed = (seedEl?.value || "").trim();

		let modEffects = window.__t2iCollectModifierEffects48739();
		let styledPrompt = window.__t2iApplyStylePrompt48739(prompt, style);
		let styledNegative = window.__t2iApplyStyleNegative48739(negativePrompt, style);

		let options = {};
		for(let k in window.__t2iFrameworkSettings48739.imageOptions) {
			options[k] = window.__t2iFrameworkSettings48739.imageOptions[k];
		}

		options.prompt = [modEffects.promptPrefix, styledPrompt, modEffects.promptSuffix].filter(Boolean).join(", ");
		options.negativePrompt = [styledNegative, modEffects.negativeSuffix].filter(Boolean).join(", ");
		if(seed !== "") options.seed = seed;

		let width = Number(widthEl?.value || 0);
		let height = Number(heightEl?.value || 0);
		let guidanceScale = Number(guidanceEl?.value || 0);
		let steps = Number(stepsEl?.value || 0);
		if(!isNaN(width) && width > 0) options.width = width;
		if(!isNaN(height) && height > 0) options.height = height;
		if(!isNaN(guidanceScale) && guidanceScale > 0) options.guidanceScale = guidanceScale;
		if(!isNaN(steps) && steps > 0) options.numInferenceSteps = steps;

		return options;
	};

	window.__t2iGetSnapshot48739 = function() {
		let styleEl = document.querySelector("#t2iStyleEl48739");
		let countEl = document.querySelector("#t2iCountEl48739");
		let modEffects = window.__t2iCollectModifierEffects48739();
		let styleTools = window.__t2iGetStyleToolState48739();
		return {
			v: 1,
			prompt: document.querySelector("#t2iPromptEl48739")?.value || "",
			negativePrompt: document.querySelector("#t2iNegativeEl48739")?.value || "",
			seed: document.querySelector("#t2iSeedEl48739")?.value || "",
			style: styleEl?.value || "none",
			styleSearch: styleTools.search || "",
			styleSort: styleTools.sortMode || settings.defaultStyleSort || "featured",
			favoritesOnly: Boolean(styleTools.favoritesOnly),
			count: Number(countEl?.value || window.__t2iFrameworkSettings48739.defaultImageCount || 6),
			width: document.querySelector("#t2iWidthEl48739")?.value || "",
			height: document.querySelector("#t2iHeightEl48739")?.value || "",
			guidanceScale: document.querySelector("#t2iGuidanceEl48739")?.value || "",
			steps: document.querySelector("#t2iStepsEl48739")?.value || "",
			modifiers: modEffects.selected || {},
		};
	};

	window.__t2iApplySnapshot48739 = function(data) {
		if(!data) return;
		let apply = (id, value) => {
			let el = document.querySelector(id);
			if(el && value !== undefined && value !== null) el.value = String(value);
		};
		apply("#t2iPromptEl48739", data.prompt);
		apply("#t2iNegativeEl48739", data.negativePrompt);
		apply("#t2iSeedEl48739", data.seed);
		apply("#t2iStyleEl48739", data.style);
		apply("#t2iStyleSearchEl48739", data.styleSearch);
		apply("#t2iStyleSortEl48739", data.styleSort);
		let favoritesOnlyEl = document.querySelector("#t2iFavoritesOnlyEl48739");
		if(favoritesOnlyEl && data.favoritesOnly !== undefined) favoritesOnlyEl.checked = Boolean(data.favoritesOnly);
		window.__t2iApplyStyleToolState48739({
			search: document.querySelector("#t2iStyleSearchEl48739")?.value || "",
			sortMode: document.querySelector("#t2iStyleSortEl48739")?.value || settings.defaultStyleSort || "featured",
			favoritesOnly: Boolean(document.querySelector("#t2iFavoritesOnlyEl48739")?.checked),
		});
		window.__t2iRenderStyleModifierInputs48739();
		apply("#t2iCountEl48739", data.count);
		apply("#t2iWidthEl48739", data.width);
		apply("#t2iHeightEl48739", data.height);
		apply("#t2iGuidanceEl48739", data.guidanceScale);
		apply("#t2iStepsEl48739", data.steps);

		let mods = data.modifiers || {};
		for(let key in mods) {
			let el = null;
			if(String(key).startsWith("style:")) {
				el = document.querySelector(`#t2iStyleMod_${String(key).slice(6)}_48739`);
			} else {
				el = document.querySelector(`#t2iMod_${key}_48739`);
			}
			if(el) el.value = mods[key];
		}
		window.__t2iRefreshStyleCards48739();
	};

	window.__t2iEncodeSnapshot48739 = function(data) {
		try {
			return btoa(unescape(encodeURIComponent(JSON.stringify(data))));
		} catch(e) {
			console.error(e);
			return "";
		}
	};

	window.__t2iDecodeSnapshot48739 = function(encoded) {
		try {
			return JSON.parse(decodeURIComponent(escape(atob(encoded))));
		} catch(e) {
			console.error(e);
			return null;
		}
	};

	window.__t2iBuildShareUrl48739 = function() {
		let data = window.__t2iGetSnapshot48739();
		let encoded = window.__t2iEncodeSnapshot48739(data);
		if(!encoded) return "";
		let base = `${location.origin}${location.pathname}`;
		return `${base}#t2i=${encoded}`;
	};

	window.__t2iExportShareLink48739 = async function() {
		let link = window.__t2iBuildShareUrl48739();
		if(!link) {
			alert("Failed to build share link.");
			return;
		}
		document.querySelector("#t2iShareLinkEl48739").value = link;
		if(navigator.clipboard && navigator.clipboard.writeText) {
			try {
				await navigator.clipboard.writeText(link);
				alert("Share link copied to clipboard.");
				return;
			} catch(e) {
				console.error(e);
			}
		}
		alert("Share link generated in the text box.");
	};

	window.__t2iImportShareLink48739 = function() {
		let text = (document.querySelector("#t2iShareLinkEl48739")?.value || "").trim();
		if(!text) {
			alert("Paste a share link first.");
			return;
		}
		let token = "";
		if(text.startsWith("http")) {
			let hash = text.split("#")[1] || "";
			if(hash.startsWith("t2i=")) token = hash.slice(4);
		} else if(text.startsWith("t2i=")) {
			token = text.slice(4);
		} else {
			token = text;
		}
		let data = window.__t2iDecodeSnapshot48739(token);
		if(!data) {
			alert("Invalid share data.");
			return;
		}
		window.__t2iApplySnapshot48739(data);
		alert("Settings imported.");
	};

	window.__t2iImportFromHash48739 = function() {
		let hash = location.hash || "";
		if(!hash.startsWith("#t2i=")) return;
		let encoded = hash.replace("#t2i=", "");
		let data = window.__t2iDecodeSnapshot48739(encoded);
		if(data) window.__t2iApplySnapshot48739(data);
	};

	window.__t2iRandomizeSeed48739 = function() {
		let seedEl = document.querySelector("#t2iSeedEl48739");
		if(!seedEl) return;
		seedEl.value = String(Math.floor(Math.random()*900000000) + 100000000);
	};

	window.__t2iClearOutput48739 = function() {
		let outputEl = document.querySelector("#t2iOutputEl48739");
		if(outputEl) outputEl.innerHTML = "<div class='t2i-empty48739'>Output cleared.</div>";
	};

	window.__t2iToggleStyleGrid48739 = function(btn) {
		let gridEl = document.querySelector("#t2iStyleVisualGrid48739");
		if(!gridEl) return;
		let currentDisplay = gridEl.style.display || window.getComputedStyle(gridEl).display;
		if(currentDisplay === "none") {
			gridEl.style.display = "grid";
			if(btn) btn.textContent = "Hide Style Grid";
		} else {
			gridEl.style.display = "none";
			if(btn) btn.textContent = "Show Style Grid";
		}
	};

	window.__t2iGetStyleToolState48739 = function() {
		let state = window.__t2iFrameworkState48739 || {};
		let searchEl = document.querySelector("#t2iStyleSearchEl48739");
		let sortEl = document.querySelector("#t2iStyleSortEl48739");
		let favoritesOnlyEl = document.querySelector("#t2iFavoritesOnlyEl48739");
		return {
			search: searchEl ? searchEl.value : (state.lastStyleSearch || ""),
			sortMode: sortEl ? sortEl.value : (state.lastStyleSort || settings.defaultStyleSort || "featured"),
			favoritesOnly: favoritesOnlyEl ? favoritesOnlyEl.checked : Boolean(state.showFavoritesOnly),
		};
	};

	window.__t2iApplyStyleToolState48739 = function(nextState) {
		let state = window.__t2iFrameworkState48739 || {};
		state.lastStyleSearch = String(nextState?.search || "");
		state.lastStyleSort = String(nextState?.sortMode || settings.defaultStyleSort || "featured");
		state.showFavoritesOnly = Boolean(nextState?.favoritesOnly);
	};

	window.__t2iGetFilteredSortedStyles48739 = function() {
		let catalog = window.__t2iGetStyleCatalog48739();
		let toolState = window.__t2iGetStyleToolState48739();
		let search = window.__t2iNormalizeSearchText48739(toolState.search);
		let sortMode = String(toolState.sortMode || settings.defaultStyleSort || "featured");
		let favoritesOnly = Boolean(toolState.favoritesOnly);

		let state = window.__t2iFrameworkState48739 || {};
		let favorites = state.favoriteStyles instanceof Set ? state.favoriteStyles : new Set();
		let recentStyles = Array.isArray(state.recentStyles) ? state.recentStyles : [];
		let recentRank = new Map();
		for(let i = 0; i < recentStyles.length; i++) {
			recentRank.set(recentStyles[i], i);
		}

		let rows = catalog.filter(style => {
			if(favoritesOnly && !favorites.has(style.name)) return false;
			if(!search) return true;
			let haystack = style.searchText || window.__t2iNormalizeSearchText48739(`${style.name || ""} ${style.label || ""} ${style.group || ""} ${style.tagsText || ""}`);
			return String(haystack).includes(search);
		});

		let sorted = [...rows];
		let byFeatured = (a, b) => Number(a.disabled) - Number(b.disabled) || Number(a.sortIndex || 0) - Number(b.sortIndex || 0);

		if(sortMode === "alphabetical") {
			sorted.sort((a, b) => Number(a.disabled) - Number(b.disabled) || String(a.label || "").localeCompare(String(b.label || ""), undefined, {sensitivity:"base"}));
		} else if(sortMode === "group") {
			sorted.sort((a, b) => Number(a.disabled) - Number(b.disabled)
				|| Number(a.groupIndex || 0) - Number(b.groupIndex || 0)
				|| String(a.group || "").localeCompare(String(b.group || ""), undefined, {sensitivity:"base"})
				|| String(a.label || "").localeCompare(String(b.label || ""), undefined, {sensitivity:"base"}));
		} else if(sortMode === "favorites") {
			sorted.sort((a, b) => Number(favorites.has(b.name)) - Number(favorites.has(a.name)) || byFeatured(a, b));
		} else if(sortMode === "recent") {
			sorted.sort((a, b) => {
				let aRank = recentRank.has(a.name) ? recentRank.get(a.name) : Number.MAX_SAFE_INTEGER;
				let bRank = recentRank.has(b.name) ? recentRank.get(b.name) : Number.MAX_SAFE_INTEGER;
				return Number(a.disabled) - Number(b.disabled) || aRank - bRank || byFeatured(a, b);
			});
		} else if(sortMode === "random") {
			let enabled = sorted.filter(s => !s.disabled).sort(() => Math.random() - 0.5);
			let disabled = sorted.filter(s => s.disabled).sort(() => Math.random() - 0.5);
			sorted = [...enabled, ...disabled];
		} else {
			sorted.sort(byFeatured);
		}

		return {
			styles: sorted,
			total: catalog.length,
			visible: sorted.length,
			search,
			sortMode,
			favoritesOnly,
		};
	};

	window.__t2iRenderStyleCards48739 = function() {
		let gridEl = document.querySelector("#t2iStyleVisualGrid48739");
		if(!gridEl) return;

		let selectEl = document.querySelector("#t2iStyleEl48739");
		let selected = selectEl?.value || "none";
		let data = window.__t2iGetFilteredSortedStyles48739();
		window.__t2iApplyStyleToolState48739(data);

		let statsEl = document.querySelector("#t2iStyleStatsEl48739");
		if(statsEl && settings.enableStyleCounts) {
			statsEl.textContent = `${data.visible} / ${data.total} styles`;
		}

		if(data.styles.length === 0) {
			gridEl.innerHTML = `<div class="t2i-empty48739">No styles matched your current search/filter.</div>`;
			return;
		}

		gridEl.innerHTML = data.styles.map(style => {
			let safeStyleName = window.__t2iEscapeAttr48739(style.name);
			let safeStyleLabel = window.__t2iEscapeAttr48739(style.label);
			let safeGroupLabel = window.__t2iEscapeAttr48739(style.group || "");
			let safeImage = String(style.image || "").replaceAll("'", "%27");
			let preview = style.image
				? `<div class="t2i-style-preview48739" style="background-image:url('${safeImage}')"></div>`
				: `<div class="t2i-style-preview48739" style="background:${style.swatch || "linear-gradient(135deg, #4f46e5, #10b981)"}"></div>`;

			let isFavorite = window.__t2iIsStyleFavorite48739(style.name);
			let favoriteBtn = "";
			if(settings.enableStyleFavorites && !style.disabled) {
				favoriteBtn = `<button type="button" class="t2i-style-fav-btn48739 ${isFavorite ? "active" : ""}" data-style-name="${safeStyleName}" onclick="event.stopPropagation(); window.__t2iToggleFavoriteStyle48739(this.dataset.styleName);" aria-label="Toggle favorite">${isFavorite ? "★" : "☆"}</button>`;
			}

			let cardClasses = `t2i-style-card48739${style.disabled ? " disabled" : ""}${style.name === selected ? " active" : ""}`;
			let clickAttrs = style.disabled
				? ""
				: `onclick=\"window.__t2iSetStyle48739(this.dataset.styleName)\" onkeydown=\"if(event.key==='Enter'||event.key===' '){event.preventDefault();window.__t2iSetStyle48739(this.dataset.styleName);}\"`;

			return `<div role="button" tabindex="${style.disabled ? "-1" : "0"}" class="${cardClasses}" data-style-name="${safeStyleName}" ${clickAttrs}>${preview}${favoriteBtn}<span class="t2i-style-label48739">${safeStyleLabel}</span>${style.group ? `<span class="t2i-style-meta48739">${safeGroupLabel}</span>` : ""}</div>`;
		}).join("\n");
	};

	window.__t2iClearStyleSearch48739 = function() {
		let searchEl = document.querySelector("#t2iStyleSearchEl48739");
		if(!searchEl) return;
		searchEl.value = "";
		window.__t2iRefreshStyleCards48739();
	};

	window.__t2iSetStyle48739 = function(styleName) {
		let selectEl = document.querySelector("#t2iStyleEl48739");
		if(selectEl) {
			let optionEl = Array.from(selectEl.options || []).find(o => o.value === styleName);
			if(optionEl && optionEl.disabled) return;
			selectEl.value = styleName;
		}
		window.__t2iMarkStyleUsed48739(styleName);
		window.__t2iRefreshStyleCards48739();
	};

	window.__t2iRefreshStyleCards48739 = function() {
		let selectEl = document.querySelector("#t2iStyleEl48739");
		let selectedOption = selectEl?.selectedOptions?.[0] || null;
		if(selectEl && (!selectedOption || selectedOption.disabled) && window.__t2iDefaultStyleKey48739) {
			selectEl.value = window.__t2iDefaultStyleKey48739;
			selectedOption = selectEl.selectedOptions?.[0] || null;
		}
		window.__t2iRenderStyleModifierInputs48739();
		window.__t2iRenderStyleCards48739();
	};

	window.__t2iGeneratePersona48739 = async function(btn, imageCtn) {
		if(!window.__t2iFrameworkSettings48739.enablePersonaHooks) return;
		let frame = imageCtn?.querySelector("iframe");
		let out = frame?.textToImagePluginOutput;
		if(!out) {
			alert("Please wait until the image is finished generating.");
			return;
		}
		btn.disabled = true;
		let oldText = btn.textContent;
		btn.textContent = "Persona...";

		let prompt = out.inputs?.prompt || "";
		let name = "";
		let description = "";

		if(window.__t2iFrameworkSettings48739.persona.enableAiDescription) {
			try {
				let response = await aiText({
					instruction: `${window.__t2iFrameworkSettings48739.persona.defaultInstruction}\n\nImage prompt: ${prompt}\n\nRespond using this format:\nName: ...\nDescription: ...`,
					maxCharacters: 900,
				});
				let text = String(response?.text || response || "");
				name = ((text.match(/Name:\s*(.+)/i) || [])[1] || "Unnamed Character").trim();
				description = ((text.match(/Description:\s*([\s\S]+)/i) || [])[1] || text).trim();
			} catch(e) {
				console.error(e);
			}
		}

		if(!description) {
			name = "Generated Persona";
			description = `A character inspired by this image prompt: ${prompt}`;
		}

		imageCtn.dataset.personaName = name;
		imageCtn.dataset.personaDescription = description;
		btn.textContent = "Persona Ready";
		setTimeout(() => {
			btn.textContent = oldText;
			btn.disabled = false;
		}, 700);

		if(typeof window.__t2iFrameworkSettings48739.persona.onCreate === "function") {
			try {
				window.__t2iFrameworkSettings48739.persona.onCreate({name, description, imageCtn, output: out});
			} catch(e) {
				console.error(e);
			}
		}
	};

	window.__t2iOpenChat48739 = function(imageCtn) {
		if(!window.__t2iFrameworkSettings48739.enablePersonaHooks) return;
		let frame = imageCtn?.querySelector("iframe");
		let out = frame?.textToImagePluginOutput;
		if(!out) {
			alert("Image data is not ready yet.");
			return;
		}
		let name = imageCtn.dataset.personaName || "Generated Character";
		let description = imageCtn.dataset.personaDescription || `Character inspired by: ${out.inputs?.prompt || "image prompt"}`;
		let payload = {
			name,
			description,
			imagePrompt: out.inputs?.prompt || "",
			imageDataUrl: out.dataUrl || "",
			timestamp: Date.now(),
		};
		let encoded = encodeURIComponent(JSON.stringify(payload));
		let url = `${window.__t2iFrameworkSettings48739.persona.chatBaseUrl}#${encoded}`;
		window.open(url, "_blank", "noopener,noreferrer");
	};

	window.__t2iPrivateSave48739 = async function(btn, imageCtn) {
		try {
			if(!window.__t2iFrameworkState48739.privateGallery) {
				alert("Private gallery is disabled.");
				return;
			}
			let frame = imageCtn?.querySelector("iframe");
			let out = frame?.textToImagePluginOutput;
			if(!out) {
				alert("Please wait until the image is finished generating.");
				return;
			}
			btn.disabled = true;
			let imageBlob = await fetch(out.dataUrl).then(r => r.blob());
			await window.__t2iFrameworkState48739.privateGallery.add(imageBlob, {
				info: {
					prompt: out.inputs?.prompt,
					negativePrompt: out.inputs?.negativePrompt,
					seed: out.inputs?.seed,
				}
			});
			btn.textContent = "Saved";
			setTimeout(() => {
				btn.textContent = "Private Save";
				btn.disabled = false;
			}, 700);
		} catch(e) {
			console.error(e);
			alert("Failed to save image.");
			btn.disabled = false;
		}
	};

	window.__t2iOpenPrivateGallery48739 = function() {
		if(!window.__t2iFrameworkState48739.privateGallery) {
			alert("Private gallery is disabled.");
			return;
		}
		window.__t2iFrameworkState48739.privateGallery.show();
	};

	window.__t2iGenerate48739 = async function() {
		let countEl = document.querySelector("#t2iCountEl48739");
		let outputEl = document.querySelector("#t2iOutputEl48739");
		let btn = document.querySelector("#t2iGenerateBtn48739");
		if(!outputEl || !btn) return;
		let numImages = Number(countEl?.value || window.__t2iFrameworkSettings48739.defaultImageCount || 6);
		if(isNaN(numImages) || numImages < 1) numImages = 1;
		if(numImages > 24) numImages = 24;
		btn.disabled = true;
		btn.textContent = "Generating...";

		let actionButtons = [];
		if(window.__t2iFrameworkSettings48739.enablePersonaHooks) {
			actionButtons.push(`<button onclick="window.__t2iGeneratePersona48739(this, this.closest('.t2i-image-ctn48739'))">Persona</button>`);
			actionButtons.push(`<button onclick="window.__t2iOpenChat48739(this.closest('.t2i-image-ctn48739'))">Chat Link</button>`);
		}
		if(window.__t2iFrameworkSettings48739.imageButtons.privateSave) {
			actionButtons.push(`<button onclick="window.__t2iPrivateSave48739(this, this.closest('.t2i-image-ctn48739'))">Private Save</button>`);
		}
		let actions = actionButtons.join("");

		let template = `<div class="t2i-image-ctn48739">[window.__t2iFrameworkTextPlugin48739(window.__t2iBuildImageOptions48739())]<div class="t2i-image-actions48739">${actions}</div></div>`;
		outputEl.innerHTML = template.repeat(numImages).evaluateItem;

		btn.disabled = false;
		btn.textContent = "Generate";
	};

	window.__t2iToggleComments48739 = function() {
		let commentsWrap = document.querySelector("#t2iCommentsWrap48739");
		if(!commentsWrap) return;
		let hiddenNow = commentsWrap.dataset.hidden === "1";
		if(hiddenNow) {
			commentsWrap.dataset.hidden = "0";
			commentsWrap.style.display = "";
		} else {
			commentsWrap.dataset.hidden = "1";
			commentsWrap.style.display = "none";
		}
	};

	window.__t2iMountComments48739 = function() {
		let host = document.querySelector("#t2iComments48739");
		if(!host || host.dataset.mounted === "1") return;
		host.dataset.mounted = "1";
		host.innerHTML = window.__t2iFrameworkCommentsPlugin48739(window.__t2iFrameworkSettings48739.commentOptions || {});
	};

	window.__t2iBoot48739 = function() {
		window.__t2iMountComments48739();

		let state = window.__t2iFrameworkState48739 || {};
		state.favoriteStyles = window.__t2iLoadFavoriteStyles48739();
		if(!Array.isArray(state.recentStyles)) state.recentStyles = [];

		let searchEl = document.querySelector("#t2iStyleSearchEl48739");
		if(searchEl) {
			if(searchEl.dataset.bound !== "1") {
				searchEl.dataset.bound = "1";
				searchEl.addEventListener("input", () => window.__t2iRefreshStyleCards48739());
			}
			searchEl.value = String(state.lastStyleSearch || "");
		}

		let sortEl = document.querySelector("#t2iStyleSortEl48739");
		if(sortEl) {
			if(sortEl.dataset.bound !== "1") {
				sortEl.dataset.bound = "1";
				sortEl.addEventListener("change", () => window.__t2iRefreshStyleCards48739());
			}
			let desired = String(state.lastStyleSort || settings.defaultStyleSort || "featured");
			if(Array.from(sortEl.options || []).some(o => o.value === desired)) {
				sortEl.value = desired;
			} else {
				sortEl.value = String(settings.defaultStyleSort || "featured");
			}
		}

		let favoritesOnlyEl = document.querySelector("#t2iFavoritesOnlyEl48739");
		if(favoritesOnlyEl) {
			if(favoritesOnlyEl.dataset.bound !== "1") {
				favoritesOnlyEl.dataset.bound = "1";
				favoritesOnlyEl.addEventListener("change", () => window.__t2iRefreshStyleCards48739());
			}
			favoritesOnlyEl.checked = Boolean(state.showFavoritesOnly);
		}

		let styleEl = document.querySelector("#t2iStyleEl48739");
		if(styleEl && window.__t2iDefaultStyleKey48739) {
			let selectedOption = styleEl.selectedOptions?.[0] || null;
			if(!selectedOption || selectedOption.disabled) {
				styleEl.value = window.__t2iDefaultStyleKey48739;
			}
		}

		window.__t2iMarkStyleUsed48739(styleEl?.value || window.__t2iDefaultStyleKey48739);
		window.__t2iRefreshStyleCards48739();
		window.__t2iImportFromHash48739();
		window.__t2iRefreshStyleCards48739();
	};

	let styleCatalog = [];
	let styleMap = {};
	let styleNameToKey = {};
	let styleOptionHtml = "";
	let defaultStyleKey = "";

	function resolveStyleTagsText48739(node) {
		try {
			let raw = node?.["meta:tags"];
			if(raw === undefined || raw === null) return "";
			if(raw.evaluateItem !== undefined) raw = raw.evaluateItem;
			if(Array.isArray(raw)) return raw.map(v => String(v)).join(" ");
			if(typeof raw === "string") return raw;
			if(typeof raw === "object") return Object.keys(raw).join(" ");
		} catch(e) {
			console.error(e);
		}
		return "";
	}

	if(settings.artStyle?.options?.getAllKeys || settings.artStyle?.options?.getChildNames) {
		let thereAreImports = false;
		let compiledStyles = new Map();
		let nameToForcedPosition = {};
		let nextGroupIndex = -1;

		function createGroupContext({label = "", color = "", index = null} = {}) {
			if(index === null) {
				nextGroupIndex++;
				index = nextGroupIndex;
			}
			return {label, color, index};
		}

		function isLikelyGroupNode(node) {
			let nodeKeys = node?.getAllKeys || window.__t2iGetNodeKeys48739(node);
			if(!node || !nodeKeys || nodeKeys.length === 0) return false;
			if(node["meta:import"] !== undefined) return true;
			if(node.color !== undefined) return true;

			// Heuristic: grouped containers usually contain child option nodes, while leaf options usually expose prompt/negative/meta keys.
			let optionLeafHintKeys = new Set(["prompt", "negative", "name", "modifiers", "randomPrompt", "meta:tags", "meta:image", "meta:selected", "meta:disabled", "meta:position"]);
			if([...optionLeafHintKeys].some(k => node[k] !== undefined)) return false;

			let childKeys = nodeKeys.filter(k => !String(k).startsWith("meta:"));
			if(childKeys.length === 0) return false;

			let nestedNodeCount = childKeys.filter(k => {
				let child = node[k];
				let childKeys = child?.getAllKeys || window.__t2iGetNodeKeys48739(child);
				return child && childKeys && childKeys.length > 0;
			}).length;
			return nestedNodeCount > 0;
		}

		function addCompiledOption(name, optionNode, groupCtx) {
			if(compiledStyles.has(name)) return; // earlier definitions win

			optionNode.___groupIndex = groupCtx.index;
			optionNode.___groupLabel = groupCtx.label || "";
			optionNode.___groupColor = groupCtx.color || "";

			compiledStyles.set(name, optionNode);

			if(optionNode["meta:position"] !== undefined) {
				nameToForcedPosition[name] = Number(optionNode["meta:position"]);
			}
		}

		function processImport(importNode, groupCtx) {
			if(!importNode) return;
			thereAreImports = true;

			let tagImportWeights = {};
			if(importNode.tagWeights) {
				let weightsText = String(window.__t2iEvaluateStyleField48739(importNode.tagWeights || "")).trim();
				if(weightsText) {
					tagImportWeights = Object.fromEntries(weightsText.split(",").map(t => {
						let tag = String(t).split(":")[0].trim();
						let factor = Number(String(t).split(":")[1] ?? 10); // default boost is 10
						if(isNaN(factor)) factor = 10;
						return [tag, factor];
					}));
				}
			}

			let sourceNode = importNode.from || importNode;
			let importedEntries = [];
			if(sourceNode?.selectAll) {
				for(let optionItem of sourceNode.selectAll) {
					let optionName = String(optionItem?.getName || "");
					if(!optionName) continue;
					importedEntries.push([optionName, optionItem]);
				}
			} else {
				for(let key of window.__t2iGetNodeKeys48739(sourceNode)) {
					let keyText = String(key);
					if(keyText.startsWith("meta:")) continue;
					let optionNode = sourceNode[key];
					if(!optionNode) continue;
					importedEntries.push([keyText, optionNode]);
				}
			}

			let intraGroupSortingEpsilon = 0.00001; // keeps same-score imports in their original order
			for(let [optionName, optionItem] of importedEntries) {
				if(compiledStyles.has(optionName)) continue; // higher precedence already defined

				addCompiledOption(optionName, optionItem, groupCtx);

				if(optionItem["meta:tags"]) {
					optionItem.___intraGroupRankingScore = 0;
					let thereWereTagWeightMatches = false;
					for(let [tag, inherentTagWeight] of Object.entries(optionItem["meta:tags"])) {
						if(tagImportWeights[tag] !== undefined) {
							thereWereTagWeightMatches = true;
							let tagWeight = Number(inherentTagWeight);
							if(isNaN(tagWeight)) tagWeight = 1;
							optionItem.___intraGroupRankingScore += tagWeight*tagImportWeights[tag];
						}
					}
					if(!thereWereTagWeightMatches) {
						optionItem.___intraGroupRankingScore = 1;
					}
				} else {
					optionItem.___intraGroupRankingScore = 1;
				}

				optionItem.___intraGroupRankingScore += intraGroupSortingEpsilon;
				intraGroupSortingEpsilon -= intraGroupSortingEpsilon*0.00001;
			}
		}

		function compileOptionContainer(containerNode, inheritedGroupCtx = null) {
			for(let key of window.__t2iGetNodeKeys48739(containerNode)) {
				let keyText = String(key);
				if(keyText === "color" || keyText === "label" || keyText === "tagWeights" || keyText === "name") continue;

				if(keyText.startsWith("meta:import")) {
					let importGroupCtx = inheritedGroupCtx || createGroupContext();
					processImport(containerNode[key], importGroupCtx);
					continue;
				}

				if(keyText.startsWith("meta:")) continue;

				let childNode = containerNode[key];
				if(!childNode) continue;

				if(isLikelyGroupNode(childNode)) {
					let label = window.__t2iEvaluateStyleField48739(childNode.label || childNode.name || keyText);
					let color = window.__t2iEvaluateStyleField48739(childNode.color || "");
					let groupCtx = createGroupContext({label, color});
					compileOptionContainer(childNode, groupCtx);
					continue;
				}

				let groupCtx = inheritedGroupCtx || createGroupContext();
				childNode.___intraGroupRankingScore = 1;
				addCompiledOption(keyText, childNode, groupCtx);
			}
		}

		compileOptionContainer(settings.artStyle.options);

		let entries = [...compiledStyles.entries()];

		if(thereAreImports) {
			entries = entries.filter(e => e[1].___intraGroupRankingScore > 0);
			entries.sort((a, b) => a[1].___groupIndex - b[1].___groupIndex || b[1].___intraGroupRankingScore - a[1].___intraGroupRankingScore);
		}

		for(let [name, position] of Object.entries(nameToForcedPosition)) {
			let index = entries.findIndex(([key]) => key === name);
			if(index === -1) continue;
			let [removed] = entries.splice(index, 1);
			let target = Number(position);
			if(isNaN(target)) target = entries.length;
			if(target < 0) target = 0;
			if(target > entries.length) target = entries.length;
			entries.splice(target, 0, removed);
		}

		styleCatalog = entries.map(([name, node], sortIndex) => {
			let key = String(name);
			styleMap[key] = node;
			if(!styleNameToKey[name]) styleNameToKey[name] = key;

			let label = window.__t2iEvaluateStyleField48739(node.name || name) || String(name);
			let groupColor = window.__t2iEvaluateStyleField48739(node.___groupColor || "");
			let swatch = window.__t2iEvaluateStyleField48739(node.swatch || node["meta:swatch"] || "");
			if(!swatch && groupColor) swatch = `linear-gradient(135deg, ${groupColor}, #0ea5e9)`;
			let image = window.__t2iEvaluateStyleField48739(node["meta:image"] || node.image || "");
			let tagsText = resolveStyleTagsText48739(node);
			let selected = window.__t2iEvaluateBoolean48739(node["meta:selected"]);
			let disabled = window.__t2iEvaluateBoolean48739(node["meta:disabled"]);
			if(selected && !disabled && !defaultStyleKey) defaultStyleKey = key;

			return {
				name: key,
				label: String(label),
				group: String(node.___groupLabel || ""),
				groupIndex: Number(node.___groupIndex || 0),
				swatch: String(swatch || ""),
				image: String(image || ""),
				sortIndex,
				tagsText: String(tagsText || ""),
				searchText: window.__t2iNormalizeSearchText48739(`${key} ${label} ${String(node.___groupLabel || "")} ${String(tagsText || "")}`),
				selected,
				disabled,
				promptPrefix: "",
				promptSuffix: "",
				negativeSuffix: "",
			};
		});

		let currentGroupKey = null;
		let optionParts = [];
		for(let style of styleCatalog) {
			let optionHtml = `<option value="${window.__t2iEscapeAttr48739(style.name)}" ${style.disabled ? "disabled" : ""} ${style.selected ? "selected" : ""}>${window.__t2iEscapeAttr48739(style.label)}</option>`;
			let groupKey = style.group ? `${style.groupIndex}:${style.group}` : "";
			if(!groupKey) {
				if(currentGroupKey !== null) {
					optionParts.push(`</optgroup>`);
					currentGroupKey = null;
				}
				optionParts.push(optionHtml);
			} else {
				if(currentGroupKey !== groupKey) {
					if(currentGroupKey !== null) optionParts.push(`</optgroup>`);
					optionParts.push(`<optgroup label="${window.__t2iEscapeAttr48739(style.group)}">`);
					currentGroupKey = groupKey;
				}
				optionParts.push(optionHtml);
			}
		}
		if(currentGroupKey !== null) optionParts.push(`</optgroup>`);
		styleOptionHtml = optionParts.join("\n");
	}

	if(styleCatalog.length === 0) {
		styleCatalog = settings.styleOptions.map((item, sortIndex) => {
			if(typeof item === "string") {
				let normalized = String(item);
				return {
					name: normalized,
					label: normalized,
					promptPrefix: "",
					promptSuffix: "",
					negativeSuffix: "",
					swatch: "",
					image: "",
					selected: false,
					disabled: false,
					group: "",
					groupIndex: 0,
					sortIndex,
					tagsText: "",
					searchText: window.__t2iNormalizeSearchText48739(normalized),
				};
			}
			let selected = window.__t2iEvaluateBoolean48739(item.selected || item["meta:selected"]);
			let disabled = window.__t2iEvaluateBoolean48739(item.disabled || item["meta:disabled"]);
			let name = item.name || item.label || "style";
			let label = item.label || item.name || "Style";
			let tagsRaw = item.tags || item["meta:tags"] || "";
			let tagsText = "";
			if(Array.isArray(tagsRaw)) tagsText = tagsRaw.map(v => String(v)).join(" ");
			else if(typeof tagsRaw === "object") tagsText = Object.keys(tagsRaw || {}).join(" ");
			else tagsText = String(tagsRaw || "");
			if(selected && !disabled && !defaultStyleKey) defaultStyleKey = String(name);
			return {
				name,
				label,
				promptPrefix: item.promptPrefix || "",
				promptSuffix: item.promptSuffix || "",
				negativeSuffix: item.negativeSuffix || "",
				swatch: item.swatch || "",
				image: item.image || "",
				sortIndex,
				tagsText,
				searchText: window.__t2iNormalizeSearchText48739(`${String(name)} ${String(label)} ${tagsText}`),
				selected,
				disabled,
				group: "",
				groupIndex: 0,
			};
		});
		styleOptionHtml = styleCatalog.map(style => `<option value="${window.__t2iEscapeAttr48739(style.name)}" ${style.disabled ? "disabled" : ""} ${style.selected ? "selected" : ""}>${window.__t2iEscapeAttr48739(style.label)}</option>`).join("\n");
	}

	if(!defaultStyleKey) {
		let firstEnabledStyle = styleCatalog.find(style => !style.disabled);
		defaultStyleKey = firstEnabledStyle ? firstEnabledStyle.name : (styleCatalog[0]?.name || "none");
	}
	window.__t2iDefaultStyleKey48739 = defaultStyleKey;

	window.__t2iResolvedStyles48739 = styleCatalog;
	window.__t2iArtStyleMap48739 = styleMap;
	window.__t2iArtStyleKeyByName48739 = styleNameToKey;
	window.__t2iArtStyleOptionsRoot48739 = settings.artStyle?.options || null;

	let styleVisualHtml = "";

	let styleSortItems = [];
	if(Array.isArray(settings.styleSortOptions)) {
		styleSortItems = settings.styleSortOptions;
	} else if(settings.styleSortOptions && (settings.styleSortOptions.getAllKeys || settings.styleSortOptions.getChildNames)) {
		for(let key of window.__t2iGetNodeKeys48739(settings.styleSortOptions)) {
			let keyText = String(key);
			if(keyText.startsWith("meta:")) continue;
			let node = settings.styleSortOptions[key];
			if(node && (node.value !== undefined || node.label !== undefined)) {
				styleSortItems.push({
					value: String(window.__t2iEvaluateStyleField48739(node.value || keyText) || keyText),
					label: String(window.__t2iEvaluateStyleField48739(node.label || keyText) || keyText),
				});
			} else {
				styleSortItems.push({
					value: keyText,
					label: String(window.__t2iEvaluateStyleField48739(node || keyText) || keyText),
				});
			}
		}
	}
	if(styleSortItems.length === 0) {
		styleSortItems = [
			{value:"featured", label:"Featured"},
			{value:"favorites", label:"Favorites First"},
			{value:"recent", label:"Recent"},
			{value:"alphabetical", label:"A-Z"},
			{value:"group", label:"Group"},
			{value:"random", label:"Random"},
		];
	}

	let styleSortOptionsHtml = styleSortItems.map(item => {
		let value = String(item?.value || item || "featured");
		let label = String(item?.label || value);
		let selected = value === String(settings.defaultStyleSort || "featured") ? "selected" : "";
		return `<option value="${window.__t2iEscapeAttr48739(value)}" ${selected}>${window.__t2iEscapeAttr48739(label)}</option>`;
	}).join("\n");

	let styleToolsHtml = "";
	if(settings.enableStyleSearch || settings.enableStyleSort || settings.enableFavoritesOnlyToggle || settings.enableStyleCounts) {
		styleToolsHtml = `
		<div id="t2iStyleTools48739">
			${settings.enableStyleSearch ? `<div class="t2i-style-tool48739"><label>Style Search</label><div class="t2i-style-search-row48739"><input id="t2iStyleSearchEl48739" type="text" placeholder="${window.__t2iEscapeAttr48739(settings.styleSearchPlaceholder || "Search styles")}" /><button type="button" id="t2iStyleSearchClearBtn48739" onclick="window.__t2iClearStyleSearch48739()">Clear</button></div></div>` : ""}
			${settings.enableStyleSort ? `<div class="t2i-style-tool48739"><label>Style Sort</label><select id="t2iStyleSortEl48739">${styleSortOptionsHtml}</select></div>` : ""}
			${settings.enableFavoritesOnlyToggle ? `<label class="t2i-style-tool-inline48739"><input id="t2iFavoritesOnlyEl48739" type="checkbox" /> Favorites only</label>` : ""}
			${settings.enableStyleCounts ? `<div id="t2iStyleStatsEl48739" class="t2i-style-tool-inline48739 t2i-style-stats48739">0 / 0 styles</div>` : ""}
		</div>`;
	}

	let modifierGroupHtml = "";
	if(settings.enableModifierGroups) {
		modifierGroupHtml = (settings.modifierGroups || []).map(group => {
			let id = group.id || group.label || "group";
			let label = group.label || id;
			let options = (group.options || []).map(o => `<option value="${o.name}">${o.name}</option>`).join("\n");
			return `<div class="t2iField48739 t2iSpan4"><label>${label}</label><select id="t2iMod_${id}_48739">${options}</select></div>`;
		}).join("\n");
	}

	let shareModuleHtml = "";
	if(settings.enableShareLinks) {
		shareModuleHtml = `
		<div class="t2i-share-row48739">
			<input id="t2iShareLinkEl48739" type="text" placeholder="Share link or token" />
			<button id="t2iExportShareLinkBtn48739" type="button" onclick="window.__t2iExportShareLink48739()">Export</button>
			<button id="t2iImportShareLinkBtn48739" type="button" onclick="window.__t2iImportShareLink48739()">Import</button>
		</div>`;
	}

	let bootScript = `<img style="position:fixed;opacity:0;pointer-events:none;top:-5000px;left:-5000px;width:1px;height:1px;" src="" onerror="window.__t2iBoot48739(); this.remove();">`;

	return `<style>
		:root {
			--t2i-bg-a: ${theme.bgA};
			--t2i-bg-b: ${theme.bgB};
			--t2i-bg-c: ${theme.bgC};
			--t2i-panel: ${theme.panel};
			--t2i-text: ${theme.text};
			--t2i-muted: ${theme.muted};
			--t2i-line: ${theme.line};
			--t2i-accent: ${theme.accent};
			--t2i-accent2: ${theme.accent2};
      --t2i-hover: ${theme.hover};
			--t2i-fixedpanel: ${theme.fixedpanel};
		}
		#t2iBg48739 {
			position: fixed;
			inset: 0;
			z-index: -2;
			background:
				radial-gradient(1200px 700px at -10% -10%, color-mix(in srgb, var(--t2i-accent) 24%, transparent), transparent 66%),
				radial-gradient(1000px 620px at 110% -10%, color-mix(in srgb, var(--t2i-accent2) 24%, transparent), transparent 72%),
				linear-gradient(165deg, var(--t2i-bg-a), var(--t2i-bg-b) 55%, var(--t2i-bg-c));
		}
		#t2iRoot48739 {
			color: var(--t2i-text);
			max-width: 1220px;
			margin: 0 auto;
			padding: 0.8rem;
			font-family: "Space Grotesk", "Segoe UI", sans-serif;
		}
		#t2iCard48739 {
			background: var(--t2i-panel);
			border: 1px solid var(--t2i-line);
			border-radius: 16px;
			padding: 0.85rem;
			backdrop-filter: blur(8px);
			box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
		}
		#t2iTitle48739 { margin:0.2rem 0 0; text-align:center; font-size:clamp(1.15rem, 2.1vw, 1.7rem); }
		#t2iSubtitle48739 { margin:0.25rem 0 0.8rem; text-align:center; font-size:0.92rem; color:var(--t2i-muted); }
		#t2iControls48739 { display:grid; gap:0.55rem; }
		.t2iRow48739 { display:grid; grid-template-columns:repeat(12, minmax(0, 1fr)); gap:0.5rem; }
		.t2iField48739 { display:grid; gap:0.3rem; }
		.t2iSpan12 { grid-column:span 12; }
		.t2iSpan6 { grid-column:span 6; }
		.t2iSpan4 { grid-column:span 4; }
		.t2iSpan3 { grid-column:span 3; }
		.t2iField48739 label { font-size:0.79rem; letter-spacing:0.02em; color:var(--t2i-muted); }
		.t2iField48739 input, .t2iField48739 textarea, .t2iField48739 select {
			width:100%; box-sizing:border-box; padding:0.52rem 0.6rem; border-radius:10px; border:1px solid var(--t2i-line);
			background:color-mix(in srgb, var(--t2i-panel) 88%, transparent); color:var(--t2i-text);
		}
		.t2iField48739 textarea { min-height:4.2rem; resize:vertical; }
		.t2i-prompt-actions48739 { display:flex; gap:0.35rem; flex-wrap:wrap; margin-top:0.32rem; }
		.t2i-prompt-actions48739 .random-input-btn, .t2i-prompt-actions48739 .ai-suggest-btn, .t2i-prompt-actions48739 .random-append-btn {
			border:1px solid var(--t2i-line); background:color-mix(in srgb, var(--t2i-panel) 80%, transparent); color:var(--t2i-text);
			padding:0.26rem 0.55rem; border-radius:999px; cursor:pointer; font-size:0.78rem;
		}
		#t2iButtons48739 { display:flex; gap:0.42rem; flex-wrap:wrap; justify-content:center; margin-top:0.3rem; }
		#t2iButtons48739 button, #t2iPrivateGalleryBtn48739, .t2i-share-row48739, #t2iToggleStyleGridBtn48739 button {
			border:1px solid var(--t2i-line); background:color-mix(in srgb, var(--t2i-panel) 80%, transparent); color:var(--t2i-text);
			padding:0.36rem 0.68rem; border-radius:999px; cursor:pointer;
		}
    #t2iTopActionButtons48739 { display:flex; gap:0.42rem; flex-wrap:wrap; justify-content:center; margin-top:0.3rem; }
		#t2iTopActionButtons48739 button, .t2i-share-row48739, #t2iToggleStyleGridBtn48739 button {
			border:1px solid var(--t2i-line); background:color-mix(in srgb, var(--t2i-panel) 80%, transparent); color:var(--t2i-text);
			padding:0.36rem 0.68rem; border-radius:999px; cursor:pointer;
		}
		#t2iGenerateBtn48739 { border-color: color-mix(in srgb, var(--t2i-accent) 45%, var(--t2i-line)); }
		#t2iStyleTools48739 { display:flex; flex-wrap:wrap; gap:0.45rem; align-items:flex-end; }
		.t2i-style-tool48739 { display:grid; gap:0.28rem; min-width:220px; flex:1 1 260px; }
		.t2i-style-tool48739 label { font-size:0.79rem; letter-spacing:0.02em; color:var(--t2i-muted); }
		.t2i-style-search-row48739 { display:flex; gap:0.35rem; align-items:center; }
		.t2i-style-search-row48739 input, #t2iStyleSortEl48739 {
			width:100%; box-sizing:border-box; padding:0.52rem 0.6rem; border-radius:10px; border:1px solid var(--t2i-line);
			background:color-mix(in srgb, var(--t2i-panel) 88%, transparent); color:var(--t2i-text);
		}
		#t2iStyleSearchClearBtn48739 {
			border:1px solid var(--t2i-line); background:color-mix(in srgb, var(--t2i-panel) 80%, transparent); color:var(--t2i-text);
			padding:0.36rem 0.68rem; border-radius:999px; cursor:pointer;
		}
		.t2i-style-tool-inline48739 { display:flex; align-items:center; gap:0.35rem; font-size:0.82rem; color:var(--t2i-muted); padding:0.28rem 0.25rem; }
		.t2i-style-stats48739 { margin-left:auto; white-space:nowrap; }
		#t2iStyleVisualGrid48739 { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:0.45rem; }
		#t2iStyleVisualGrid48739 .t2i-empty48739 { grid-column:1 / -1; margin:0; padding:0.8rem; }
		#t2iStyleModifiersRow48739 { display:grid; grid-template-columns:repeat(12, minmax(0, 1fr)); gap:0.5rem; }
		.t2i-style-card48739 {
			position:relative;
			display:grid; gap:0.32rem; border:1px solid var(--t2i-line); background:color-mix(in srgb, var(--t2i-panel) 72%, transparent);
			padding:0.42rem; border-radius:12px; color:var(--t2i-text); cursor:pointer; text-align:left;
		}
		.t2i-style-card48739:focus-visible { outline:2px solid color-mix(in srgb, var(--t2i-accent) 60%, transparent); outline-offset:2px; }
		.t2i-style-card48739.active { border-color: color-mix(in srgb, var(--t2i-accent) 70%, var(--t2i-line)); box-shadow:0 0 0 1px color-mix(in srgb, var(--t2i-accent) 45%, transparent) inset; }
		.t2i-style-card48739.disabled { opacity:0.45; cursor:not-allowed; filter:saturate(0.7); }
		.t2i-style-preview48739 { width:100%; aspect-ratio: 16/9; border-radius:8px; background-size:cover; background-position:center; }
		.t2i-style-label48739 { font-size:0.84rem; color:var(--t2i-text); font-weight:600; line-height:1.2; padding-right:1.5rem; }
		.t2i-style-meta48739 { font-size:0.74rem; color:var(--t2i-muted); }
		.t2i-style-fav-btn48739 {
			position:absolute; top:0.35rem; right:0.35rem;
			border:1px solid var(--t2i-line); background:color-mix(in srgb, var(--t2i-panel) 88%, transparent); color:var(--t2i-muted);
			border-radius:999px; width:1.75rem; height:1.75rem; cursor:pointer; font-size:0.95rem; line-height:1;
		}
		.t2i-style-fav-btn48739.active {
			color:var(--t2i-accent2);
			border-color:color-mix(in srgb, var(--t2i-accent2) 55%, var(--t2i-line));
		}
		.t2i-share-row48739 { display:flex; gap:0.35rem; margin-top:0.35rem; flex-wrap:wrap; align-items:center; }
		.t2i-share-row48739 input {
			flex:1 1 300px; min-width:220px; box-sizing:border-box; padding:0.52rem 0.6rem;
			border-radius:10px; border:1px solid var(--t2i-line); background:color-mix(in srgb, var(--t2i-panel) 88%, transparent); color:var(--t2i-text);
		}
		#t2iOutputEl48739 {
			margin-top:0.85rem; display:flex; flex-wrap:wrap; justify-content:center; gap:0.42rem; min-height:8rem; padding:0.35rem;
			border:1px solid var(--t2i-line); border-radius:12px; background:color-mix(in srgb, var(--t2i-panel) 68%, transparent);
		}
		.t2i-image-ctn48739 { position:relative; margin:0.2rem; }
		.t2i-image-actions48739 { margin-top:0.24rem; text-align:center; display:flex; gap:0.3rem; justify-content:center; flex-wrap:wrap; }
		.t2i-image-actions48739 button {
			font-size:0.78rem; border:1px solid var(--t2i-line); background:color-mix(in srgb, var(--t2i-panel) 85%, transparent);
			color:var(--t2i-text); padding:0.26rem 0.52rem; border-radius:999px; cursor:pointer;
		}
		.t2i-empty48739 { font-size:0.9rem; color:var(--t2i-muted); padding:1.4rem; }
		#t2iCommentsWrap48739 {
			margin-top:1rem; border:1px solid var(--t2i-line); border-radius:12px; padding:0.35rem;
			background:color-mix(in srgb, var(--t2i-panel) 66%, transparent);
		}
		#t2iPrivateGalleryWrap48739 {
			position:fixed; left:0; right:0; bottom:0.55rem; text-align:center; z-index:90; pointer-events:none;
		}
		#t2iPrivateGalleryInner48739 { display:flex; gap:0.50rem; align-items:center; pointer-events:auto; justify-content: space-evenly;}
		#t2iPrivateGalleryBtn48739 { pointer-events:auto; }
		@media (max-width: 860px) {
			.t2iSpan6, .t2iSpan4, .t2iSpan3 { grid-column:span 12; }
			.t2i-style-tool48739 { min-width:100%; flex:1 1 100%; }
			.t2i-style-stats48739 { margin-left:0; }
		}

    #t2iExportShareLinkBtn48739, #t2iPrivateGalleryBtn48739, #t2iToggleStyleGridBtn48739, #t2iScrollTopBtn48739 #t2iImportShareLinkBtn48739, #t2iGenerateBtn48739, #t2iClearOutputBtn48739, #t2iScrollTopBtn48739 { pointer-events:auto; border:1px solid var(--t2i-line); border-radius:999px; padding:1rem;
			background:color-mix(in srgb, var(--t2i-fixedpanel) 0%, transparent);}

		button:hover, #t2iClearOutputBtn48739:hover, #t2iGenerateBtn48739:hover, #t2iToggleStyleGridBtn48739:hover, #t2iPrivateGalleryBtn48739:hover, #t2iScrollTopBtn48739:hover, .random-input-btn:hover, .random-append-btn:hover, .ai-suggest-btn:hover, #t2iExportShareLinkBtn48739:hover, #t2iImportShareLinkBtn48739:hover, #t2iRandomStyleBtn48739:hover, #t2iRandomizeSeedBtn48739:hover, #t2iStyleSearchClearBtn48739:hover, .t2i-style-fav-btn48739:hover {
      background: color-mix(in srgb, var(--t2i-hover) 66%, transparent);
    }
	</style>

	<div id="t2iBg48739"></div>
	<div id="t2iRoot48739">
		<div id="t2iCard48739">
			<h1 id="t2iTitle48739">${settings.pageTitle}</h1>
			<p id="t2iSubtitle48739">${settings.subtitle}</p>

			<div id="t2iControls48739">
				<div class="t2iRow48739">
					<div class="t2iField48739 t2iSpan12">
						<label>Prompt</label>
						<textarea id="t2iPromptEl48739">${settings.defaultPrompt}</textarea>
						<div class="t2i-prompt-actions48739">
							${settings.enableRandomInputButton ? `<button type="button" class="random-input-btn" onclick="window.__t2iRandomInput48739()">Random Input</button>` : ""}
              ${settings.enableRandomAppendButton ? `<button type="button" class="random-append-btn" onclick="window.__t2iRandomAppend48739()">Random Append</button>` : ""}
              ${settings.enableAiSuggestButton ? `<button type="button" class="ai-suggest-btn" onclick="window.__t2iAiSuggest48739(this)">AI Suggest</button>` : ""}
						</div>
					</div>
					<div class="t2iField48739 t2iSpan12">
						<label>Negative Prompt</label>
						<textarea id="t2iNegativeEl48739">${settings.defaultNegativePrompt}</textarea>
					</div>
				</div>

				<div class="t2iRow48739">
					<div class="t2iField48739 t2iSpan4">
						<label>Style</label>
						<select id="t2iStyleEl48739" onchange="window.__t2iRefreshStyleCards48739()">${styleOptionHtml}</select>
					</div>
					<div class="t2iField48739 t2iSpan4">
						<label>Seed</label>
						<input id="t2iSeedEl48739" type="text" value="${settings.defaultSeed}" />
					</div>
					<div class="t2iField48739 t2iSpan4">
						<label>Image Count</label>
						<input id="t2iCountEl48739" type="number" min="1" max="24" value="${settings.defaultImageCount}" />
					</div>
				</div>

				<div class="t2iRow48739">
					<div class="t2iField48739 t2iSpan3">
						<label>Width</label>
						<input id="t2iWidthEl48739" type="number" min="64" step="64" value="${settings.imageOptions.width || ""}" />
					</div>
					<div class="t2iField48739 t2iSpan3">
						<label>Height</label>
						<input id="t2iHeightEl48739" type="number" min="64" step="64" value="${settings.imageOptions.height || ""}" />
					</div>
					<div class="t2iField48739 t2iSpan3">
						<label>Guidance</label>
						<input id="t2iGuidanceEl48739" type="number" min="1" step="0.5" value="${settings.imageOptions.guidanceScale || ""}" />
					</div>
					<div class="t2iField48739 t2iSpan3">
						<label>Steps</label>
						<input id="t2iStepsEl48739" type="number" min="1" step="1" value="${settings.imageOptions.numInferenceSteps || ""}" />
					</div>
				</div>

        <div id="t2iButtons48739">
  				<button id="t2iRandomStyleBtn48739" onclick="window.__t2iRandomStyle48739()">Random Style</button>
  				<button id="t2iRandomizeSeedBtn48739" onclick="window.__t2iRandomizeSeed48739()">Random Seed</button>
  			</div>

			${styleToolsHtml}

				<div id="t2iStyleVisualGrid48739">${styleVisualHtml}</div>

				<div id="t2iStyleModifiersRow48739"></div>

				${settings.enableModifierGroups ? `<div class="t2iRow48739">${modifierGroupHtml}</div>` : ""}

				${shareModuleHtml}
			</div>

			<div id="t2iOutputEl48739"><div class="t2i-empty48739">Set prompt and click Generate.</div></div>


				<button onclick="window.__t2iToggleComments48739()" style="display: none;">Toggle Comments</button>

			<div id="t2iCommentsWrap48739" data-hidden="${settings.showComments ? "0" : "1"}" style="${settings.showComments ? "" : "display:none;"}">
				<div id="t2iComments48739"></div>
			</div>
		</div>
	</div>

	<div id="t2iPrivateGalleryWrap48739">
		<div id="t2iPrivateGalleryInner48739">
			<button id="t2iToggleStyleGridBtn48739" onclick="window.__t2iToggleStyleGrid48739(this)">Hide Style Grid</button>
      <button id="t2iGenerateBtn48739" onclick="window.__t2iGenerate48739()">Generate</button>
			<button id="t2iPrivateGalleryBtn48739" ${settings.imageButtons.privateSave ? "" : "hidden"} onclick="window.__t2iOpenPrivateGallery48739()">Private Gallery</button>
			<button id="t2iClearOutputBtn48739" onclick="window.__t2iClearOutput48739()">Clear Output</button>
      <button id="t2iScrollTopBtn48739" onclick="window.scrollTo({top:0, behavior:'smooth'})">Go To Top</button>
		</div>
	</div>

	${bootScript}
	`.replaceAll("{", "\\{").replaceAll("}", "\\}")
